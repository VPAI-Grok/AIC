{
  "name": "@aicorg/runner-remote",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "description": "Independently operable fail-closed remote production evidence runner for AIC.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/VPAI-Grok/AIC.git"
  },
  "homepage": "https://github.com/VPAI-Grok/AIC",
  "bugs": {
    "url": "https://github.com/VPAI-Grok/AIC/issues"
  },
  "keywords": [
    "aic",
    "agents",
    "assurance",
    "evidence",
    "remote-runner"
  ],
  "main": "./dist/runner-remote/src/index.js",
  "types": "./dist/runner-remote/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/runner-remote/src/index.d.ts",
      "import": "./dist/runner-remote/src/index.js",
      "default": "./dist/runner-remote/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aicorg/evidence-core": "workspace:*",
    "@aicorg/spec": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
