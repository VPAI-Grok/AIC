{
  "name": "@aicorg/cli",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "description": "CLI for AIC onboarding, behavior proof, signed trust claim, and registry workflows.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/VPAI-Grok/AIC.git"
  },
  "homepage": "https://github.com/VPAI-Grok/AIC",
  "bugs": {
    "url": "https://github.com/VPAI-Grok/AIC/issues"
  },
  "keywords": [
    "aic",
    "agents",
    "assurance",
    "attestation",
    "cli",
    "testing",
    "tooling"
  ],
  "main": "./dist/cli/src/index.js",
