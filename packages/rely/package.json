{
  "name": "@aicorg/rely",
  "version": "0.1.0-alpha.4",
  "type": "module",
  "description": "Protocol-neutral, local assurance-policy decisions for AI agent preflight checks.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/VPAI-Grok/AIC.git"
  },
  "homepage": "https://github.com/VPAI-Grok/AIC",
  "bugs": {
    "url": "https://github.com/VPAI-Grok/AIC/issues"
  },
  "keywords": [
    "aic",
    "agents",
    "assurance",
    "policy",
    "preflight",
    "trust",
    "webmcp",
    "mcp"
  ],
  "main": "./dist/rely/src/index.js",
  "types": "./dist/rely/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/rely/src/index.d.ts",
      "import": "./dist/rely/src/index.js",
      "default": "./dist/rely/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aicorg/spec": "workspace:*",
    "@aicorg/verify-core": "workspace:*"
  }
}
