{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic.dev/schemas/behavior-contract.schema.json",
  "title": "AIC Behavior Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "spec", "id", "title", "description", "action", "surfaces", "requirements", "scenarios"],
  "properties": {
    "artifact_type": { "const": "aic_behavior_contract" },
    "spec": { "const": "aic.behavior/0.1" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "action": { "$ref": "#/$defs/action" },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation_id", "risk"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "operation_id": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "entity": { "$ref": "#/$defs/entity" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "entity_type"],
      "properties": {
        "backing_resource": { "type": "string" },
        "entity_id": { "type": "string", "minLength": 1 },
        "entity_label": { "type": "string" },
        "entity_type": { "type": "string", "minLength": 1 },
        "parent_entity_id": { "type": "string" },
        "row_key": { "type": "string" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "entrypoint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human_ui", "webmcp", "mcp", "openapi", "custom"] },
        "label": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string" },
        "protocol_version": { "type": "string" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["precondition", "invariant", "side_effect", "postcondition", "recovery"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "surfaces", "parity", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "parity": { "enum": ["independent", "required"] },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_requirements"],
      "properties": {
        "status": { "enum": ["succeeded", "denied", "cancelled", "failed", "recovered"] },
        "confirmation": { "enum": ["accepted", "declined", "not_required", "not_reached"] },
        "error_code": { "type": "string" },
        "outcome": { "$ref": "#/$defs/jsonValue" },
        "required_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    }
  }
}
