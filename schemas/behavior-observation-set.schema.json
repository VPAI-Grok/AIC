{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic.dev/schemas/behavior-observation-set.schema.json",
  "title": "AIC Behavior Observation Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "contract_id", "generated_at", "observations"],
  "properties": {
    "artifact_type": { "const": "aic_behavior_observation_set" },
    "contract_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "contract_id", "scenario_id", "surface_id", "operation_id", "captured_at", "mode", "status", "checks"],
      "properties": {
        "artifact_type": { "const": "aic_behavior_observation" },
        "contract_id": { "type": "string", "minLength": 1 },
        "scenario_id": { "type": "string", "minLength": 1 },
        "surface_id": { "type": "string", "minLength": 1 },
        "operation_id": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "number", "minimum": 0 },
        "mode": { "enum": ["executed", "imported"] },
        "status": { "enum": ["succeeded", "denied", "cancelled", "failed", "recovered"] },
        "confirmation": { "enum": ["accepted", "declined", "not_required", "not_reached"] },
        "error_code": { "type": "string" },
        "outcome": { "$ref": "#/$defs/jsonValue" },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "passed"],
      "properties": {
        "requirement_id": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "message": { "type": "string" },
        "actual": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["log", "receipt", "screenshot", "trace", "other"] },
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "type": "string" }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    }
  }
}
