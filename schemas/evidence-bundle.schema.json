{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic.dev/schemas/evidence-bundle.schema.json",
  "title": "AIC Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifacts",
    "contract",
    "deployment_identity",
    "generated_at",
    "observations",
    "plan",
    "receipt",
    "receipt_digest",
    "spec",
    "status"
  ],
  "properties": {
    "artifact_type": { "const": "aic_evidence_bundle" },
    "spec": { "const": "aic.evidence/0.1" },
    "status": { "const": "completed" },
    "generated_at": { "type": "string", "format": "date-time" },
    "contract": { "$ref": "./behavior-contract.schema.json" },
    "plan": { "$ref": "./evidence-plan.schema.json" },
    "deployment_identity": { "$ref": "./deployment-identity.schema.json" },
    "observations": { "$ref": "./behavior-observation-set.schema.json" },
    "receipt_digest": { "$ref": "#/$defs/digest" },
    "receipt_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/digest" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content", "digest", "kind", "media_type", "ref"],
        "properties": {
          "content": {},
          "digest": { "$ref": "#/$defs/digest" },
          "kind": { "enum": ["log", "receipt", "trace", "other"] },
          "media_type": { "const": "application/json" },
          "ref": { "type": "string", "pattern": "^urn:aic:evidence:[0-9a-f]{64}$" }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapters",
        "artifact_type",
        "completed_at",
        "contract",
        "deployment_identity_digest",
        "evidence_manifest_digest",
        "job_id",
        "observations_digest",
        "plan_digest",
        "request_count",
        "runner",
        "spec",
        "started_at",
        "target"
      ],
      "properties": {
        "artifact_type": { "const": "aic_evidence_receipt" },
        "spec": { "const": "aic.evidence/0.1" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "job_id": { "type": "string", "minLength": 1 },
        "request_count": { "type": "integer", "minimum": 1 },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "id"],
          "properties": {
            "digest": { "$ref": "#/$defs/digest" },
            "id": { "type": "string", "minLength": 1 }
          }
        },
        "plan_digest": { "$ref": "#/$defs/digest" },
        "observations_digest": { "$ref": "#/$defs/digest" },
        "deployment_identity_digest": { "$ref": "#/$defs/digest" },
        "evidence_manifest_digest": { "$ref": "#/$defs/digest" },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "protocol_version", "version"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "protocol_version": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "software_name", "software_revision", "software_version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "software_name": { "type": "string", "minLength": 1 },
            "software_version": { "type": "string", "minLength": 1 },
            "software_revision": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deployment_id", "environment", "origin", "source_revision"],
          "properties": {
            "deployment_id": { "type": "string", "minLength": 1 },
            "environment": { "const": "production" },
            "origin": { "type": "string", "format": "uri", "pattern": "^https://[^/]+$" },
            "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
