{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic.dev/schemas/transparency-index.schema.json",
  "title": "AIC Transparency Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "spec", "log_id", "entries", "checkpoint"],
  "properties": {
    "artifact_type": { "const": "aic_transparency_index" },
    "spec": { "const": "aic.transparency/0.1" },
    "log_id": { "type": "string", "minLength": 1 },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "checkpoint": { "$ref": "./transparency-checkpoint.schema.json" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "logged_at", "kind", "artifact_digest", "previous_entry_digest", "artifact", "entry_digest"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "logged_at": { "type": "string", "format": "date-time" },
        "kind": { "enum": ["attestation", "key_transition", "key_revocation"] },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "previous_entry_digest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
        "artifact": {},
        "external_receipts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/receipt" } },
        "entry_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "provider", "reference", "artifact_digest"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "artifact_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
