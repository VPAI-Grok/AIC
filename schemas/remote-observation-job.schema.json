{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aic.dev/schemas/remote-observation-job.schema.json",
  "title": "AIC Remote Observation Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "contract", "id", "plan", "policy", "spec", "target"],
  "properties": {
    "artifact_type": { "const": "aic_remote_observation_job" },
    "spec": { "const": "aic.remote/0.1" },
    "id": { "type": "string", "minLength": 1 },
    "contract": { "$ref": "./behavior-contract.schema.json" },
    "plan": { "$ref": "./evidence-plan.schema.json" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "expected_deployment_id", "expected_source_revision", "identity_path", "origin"],
      "properties": {
        "environment": { "const": "production" },
        "origin": { "type": "string", "format": "uri", "pattern": "^https://[^/]+$" },
        "identity_path": { "type": "string", "pattern": "^/(?!/)" },
        "expected_deployment_id": { "type": "string", "minLength": 1 },
        "expected_source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_allowlist", "max_response_bytes", "max_run_ms", "operation_allowlist", "public_network_only", "require_https"],
      "properties": {
        "adapter_allowlist": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "operation_allowlist": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "require_https": { "const": true },
        "public_network_only": { "const": true },
        "max_run_ms": { "type": "integer", "minimum": 1 },
        "max_response_bytes": { "type": "integer", "minimum": 1 },
        "max_identity_age_seconds": { "type": "integer", "minimum": 1 },
        "allow_destructive": { "type": "boolean" },
        "allow_mutations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canary_scope", "operation_ids"],
          "properties": {
            "canary_scope": { "type": "string", "minLength": 1 },
            "operation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
