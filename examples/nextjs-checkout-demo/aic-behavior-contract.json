{
  "artifact_type": "aic_behavior_contract",
  "spec": "aic.behavior/0.1",
  "id": "checkout.complete.behavior",
  "title": "Complete checkout behavioral parity",
  "description": "The human checkout button and WebMCP tool must enforce the same authorization, confirmation, side-effect, and outcome rules.",
  "action": {
    "id": "checkout.complete",
    "operation_id": "checkout.complete.domain",
    "risk": "critical",
    "entity": {
      "entity_id": "ord_100245",
      "entity_type": "order",
      "entity_label": "Order #100245"
    }
  },
  "surfaces": [
    {
      "id": "human-ui",
      "kind": "human_ui",
      "label": "Submit order button",
      "entrypoint": "checkout.submit_order"
    },
    {
      "id": "webmcp",
      "kind": "webmcp",
      "label": "Complete checkout WebMCP tool",
      "entrypoint": "complete_checkout",
      "adapter": "@aicorg/webmcp"
    }
  ],
  "requirements": [
    {
      "id": "order.is_draft",
      "phase": "precondition",
      "description": "The order is still in draft state before execution."
    },
    {
      "id": "checkout.exact_scope",
      "phase": "precondition",
      "description": "The request is bound to the displayed order, amount, currency, and payment method."
    },
    {
      "id": "authorization.allowed",
      "phase": "invariant",
      "description": "The caller is authorized for the displayed order."
    },
    {
      "id": "authorization.denied",
      "phase": "invariant",
      "description": "An unauthorized caller is denied before confirmation or execution."
    },
    {
      "id": "confirmation.accepted",
      "phase": "invariant",
      "description": "The human accepts the exact charge confirmation."
    },
    {
      "id": "confirmation.declined",
      "phase": "invariant",
      "description": "A declined confirmation cancels execution."
    },
    {
      "id": "payment.idempotent",
      "phase": "invariant",
      "description": "Repeated or recovered execution cannot charge or submit the order more than once."
    },
    {
      "id": "execution.failure_isolated",
      "phase": "invariant",
      "description": "A provider failure before commit leaves no charge, submission, or ambiguous payment state."
    },
    {
      "id": "payment.charge",
      "phase": "side_effect",
      "description": "Exactly one payment charge is performed."
    },
    {
      "id": "order.submitted",
      "phase": "postcondition",
      "description": "The order ends in submitted state."
    },
    {
      "id": "payment.charged",
      "phase": "postcondition",
      "description": "The payment ends in charged state."
    },
    {
      "id": "checkout.audit_recorded",
      "phase": "postcondition",
      "description": "A successful commit produces exactly one checkout audit record."
    },
    {
      "id": "order.unchanged",
      "phase": "postcondition",
      "description": "A stopped operation leaves the draft order and payment unchanged."
    },
    {
      "id": "checkout.safe_recovery",
      "phase": "recovery",
      "description": "A pre-commit provider failure can be reconciled and retried without a duplicate charge."
    }
  ],
  "scenarios": [
    {
      "id": "success",
      "title": "Authorized and confirmed checkout succeeds",
      "surfaces": ["human-ui", "webmcp"],
      "parity": "required",
      "expected": {
        "status": "succeeded",
        "confirmation": "accepted",
        "outcome": {
          "order_id": "ord_100245",
          "order_status": "submitted",
          "payment_status": "charged"
        },
        "required_requirements": [
          "order.is_draft",
          "checkout.exact_scope",
          "authorization.allowed",
          "confirmation.accepted",
          "payment.idempotent",
          "payment.charge",
          "order.submitted",
          "payment.charged",
          "checkout.audit_recorded"
        ],
        "forbidden_requirements": [
          "authorization.denied",
          "confirmation.declined",
          "execution.failure_isolated",
          "order.unchanged",
          "checkout.safe_recovery"
        ]
      }
    },
    {
      "id": "authorization-denied",
      "title": "Unauthorized checkout stops before confirmation",
      "surfaces": ["human-ui", "webmcp"],
      "parity": "required",
      "expected": {
        "status": "denied",
        "confirmation": "not_reached",
        "error_code": "authorization_denied",
        "outcome": {
          "order_id": "ord_100245",
          "order_status": "draft",
          "payment_status": "unpaid"
        },
        "required_requirements": [
          "order.is_draft",
          "checkout.exact_scope",
          "authorization.denied",
          "order.unchanged"
        ],
        "forbidden_requirements": [
          "authorization.allowed",
          "confirmation.accepted",
          "confirmation.declined",
          "payment.idempotent",
          "execution.failure_isolated",
          "payment.charge",
          "order.submitted",
          "payment.charged",
          "checkout.audit_recorded",
          "checkout.safe_recovery"
        ]
      }
    },
    {
      "id": "confirmation-declined",
      "title": "Declined confirmation cancels checkout",
      "surfaces": ["human-ui", "webmcp"],
      "parity": "required",
      "expected": {
        "status": "cancelled",
        "confirmation": "declined",
        "error_code": "confirmation_declined",
        "outcome": {
          "order_id": "ord_100245",
          "order_status": "draft",
          "payment_status": "unpaid"
        },
        "required_requirements": [
          "order.is_draft",
          "checkout.exact_scope",
          "authorization.allowed",
          "confirmation.declined",
          "order.unchanged"
        ],
        "forbidden_requirements": [
          "authorization.denied",
          "confirmation.accepted",
          "payment.idempotent",
          "execution.failure_isolated",
          "payment.charge",
          "order.submitted",
          "payment.charged",
          "checkout.audit_recorded",
          "checkout.safe_recovery"
        ]
      }
    },
    {
      "id": "business-failure",
      "title": "Provider failure stops before payment commit",
      "surfaces": ["human-ui", "webmcp"],
      "parity": "required",
      "expected": {
        "status": "failed",
        "confirmation": "accepted",
        "error_code": "payment_provider_unavailable",
        "outcome": {
          "order_id": "ord_100245",
          "order_status": "draft",
          "payment_status": "unpaid"
        },
        "required_requirements": [
          "order.is_draft",
          "checkout.exact_scope",
          "authorization.allowed",
          "confirmation.accepted",
          "execution.failure_isolated",
          "order.unchanged"
        ],
        "forbidden_requirements": [
          "authorization.denied",
          "confirmation.declined",
          "payment.idempotent",
          "payment.charge",
          "order.submitted",
          "payment.charged",
          "checkout.audit_recorded",
          "checkout.safe_recovery"
        ]
      }
    },
    {
      "id": "recovery",
      "title": "A pre-commit failure recovers without a duplicate charge",
      "surfaces": ["human-ui", "webmcp"],
      "parity": "required",
      "expected": {
        "status": "recovered",
        "confirmation": "accepted",
        "outcome": {
          "order_id": "ord_100245",
          "order_status": "submitted",
          "payment_status": "charged"
        },
        "required_requirements": [
          "order.is_draft",
          "checkout.exact_scope",
          "authorization.allowed",
          "confirmation.accepted",
          "execution.failure_isolated",
          "payment.idempotent",
          "payment.charge",
          "order.submitted",
          "payment.charged",
          "checkout.audit_recorded",
          "checkout.safe_recovery"
        ],
        "forbidden_requirements": [
          "authorization.denied",
          "confirmation.declined",
          "order.unchanged"
        ]
      }
    }
  ]
}
