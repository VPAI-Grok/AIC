# Helps prevent supply chain attacks
min-release-age=7

# AIC packages are published by us from this workspace; exempt them from the
# release-age guard above so a same-day alpha can be installed. Everything else
# still honours min-release-age.
min-release-age-exclude=@aicorg/webmcp,@aicorg/sdk-react,@aicorg/runtime,@aicorg/spec
